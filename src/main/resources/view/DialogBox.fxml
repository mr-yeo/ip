<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" type="javafx.scene.layout.HBox" stylesheets="@../css/dialog-box.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <VBox fx:id="bubble" styleClass="bubble" spacing="2.0" HBox.hgrow="ALWAYS">
      <children>
        <Label fx:id="senderLabel" styleClass="sender-label" text="Label" />
        <Label fx:id="dialog" styleClass="dialog" minHeight="-Infinity" text="Label" wrapText="true" maxWidth="1.7976931348623157E308" />
      </children>
    </VBox>
    <ImageView fx:id="displayPicture" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
  </padding>
</fx:root>


